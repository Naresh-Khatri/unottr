<section id="privacy" class="relative z-10 h-[280svh] bg-[#120b25] text-white max-[900px]:h-auto motion-reduce:h-auto" data-privacy-parallax>
  <div class="sticky top-0 isolate grid min-h-svh items-center overflow-hidden [--privacy-image-y:0px] max-[900px]:relative max-[900px]:min-h-0 motion-reduce:relative" data-privacy-stage>
    <img
      class="absolute top-0 right-0 left-0 -z-2 h-[170%] w-full max-w-none origin-top translate-y-[var(--privacy-image-y)] scale-[1.015] object-cover object-top will-change-transform max-[900px]:h-full max-[900px]:translate-y-0 max-[900px]:scale-100 max-[900px]:object-[center_58%] max-[900px]:will-change-auto motion-reduce:h-full motion-reduce:translate-y-0 motion-reduce:scale-100 motion-reduce:object-[center_58%] motion-reduce:will-change-auto"
      src="/images/privacy/local-laptop-parallax-tall.webp"
      alt=""
      width="1122"
      height="1402"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <div class="pointer-events-none absolute inset-0 -z-1 bg-[linear-gradient(90deg,rgb(13_8_31/82%)_0%,rgb(13_8_31/58%)_34%,rgb(13_8_31/25%)_55%,rgb(13_8_31/68%)_100%),linear-gradient(180deg,rgb(10_6_27/36%)_0%,transparent_36%,rgb(10_6_27/34%)_100%)]" aria-hidden="true"></div>

    <div class="relative z-1 mx-auto grid w-[min(100%-2rem,87.5rem)] grid-cols-[0.86fr_1.14fr] items-center gap-[clamp(4rem,9vw,10rem)] py-[clamp(7rem,12vw,12rem)] max-[900px]:grid-cols-1 max-[900px]:py-[clamp(7rem,18vw,10rem)]">
      <div class="translate-y-8 opacity-0 transition-[opacity,transform] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:translate-y-0 motion-reduce:opacity-100 motion-reduce:transition-none" data-reveal>
        <p class="inline-flex items-center gap-[0.65rem] font-mono text-[0.69rem] font-bold tracking-[0.1em] text-[#d6c8ff] uppercase before:h-px before:w-[1.6rem] before:bg-current before:content-['']">Privacy boundary</p>
        <h2 class="mt-[1.6rem] max-w-[11ch] text-[clamp(2.65rem,4.8vw,5rem)] leading-[0.98] font-[540] tracking-[-0.065em] text-balance">Local is the default, not a privacy mode.</h2>
        <p class="mt-[1.8rem] max-w-[30rem] text-[1.02rem] leading-[1.75] text-[rgb(238_231_250/78%)] text-shadow-[0_0.1rem_1.5rem_rgb(6_3_18/58%)]">
          There is no unottr account and no background upload. Your meeting library works without
          connecting an AI provider.
        </p>
      </div>

      <dl class="grid self-center gap-3">
        <div class="flex translate-y-10 flex-col gap-[0.9rem] border border-white/14 bg-[linear-gradient(105deg,rgb(12_7_31/78%)_0%,rgb(20_12_48/57%)_62%,rgb(29_17_64/34%)_100%)] px-[clamp(1.25rem,2.4vw,2.25rem)] py-[clamp(1.5rem,2.8vw,2.35rem)] opacity-0 shadow-[0_1.6rem_4rem_-2.4rem_rgb(3_2_12/78%),inset_0_1px_rgb(255_255_255/5%)] blur-[14px] backdrop-blur-[18px] backdrop-saturate-[0.86] will-change-[opacity,filter,transform] max-[900px]:translate-y-0 max-[900px]:opacity-100 max-[900px]:blur-none max-[900px]:will-change-auto max-sm:gap-4 motion-reduce:translate-y-0 motion-reduce:opacity-100 motion-reduce:blur-none motion-reduce:will-change-auto" data-privacy-item>
          <dt class="font-mono text-[0.7rem] font-bold tracking-[0.08em] text-[#d7c9ff] uppercase">Stays local</dt>
          <dd class="max-w-[34rem] text-[clamp(1.15rem,2vw,1.55rem)] leading-[1.45] text-[#f3effc] text-shadow-[0_0.1rem_1.4rem_rgb(6_3_18/62%)]">Recordings, transcripts, speaker identities, search data, saved threads, and exports.</dd>
        </div>
        <div class="flex translate-y-10 flex-col gap-[0.9rem] border border-white/14 bg-[linear-gradient(105deg,rgb(12_7_31/78%)_0%,rgb(20_12_48/57%)_62%,rgb(29_17_64/34%)_100%)] px-[clamp(1.25rem,2.4vw,2.25rem)] py-[clamp(1.5rem,2.8vw,2.35rem)] opacity-0 shadow-[0_1.6rem_4rem_-2.4rem_rgb(3_2_12/78%),inset_0_1px_rgb(255_255_255/5%)] blur-[14px] backdrop-blur-[18px] backdrop-saturate-[0.86] will-change-[opacity,filter,transform] max-[900px]:translate-y-0 max-[900px]:opacity-100 max-[900px]:blur-none max-[900px]:will-change-auto max-sm:gap-4 motion-reduce:translate-y-0 motion-reduce:opacity-100 motion-reduce:blur-none motion-reduce:will-change-auto" data-privacy-item>
          <dt class="font-mono text-[0.7rem] font-bold tracking-[0.08em] text-[#d7c9ff] uppercase">Sent only when asked</dt>
          <dd class="max-w-[34rem] text-[clamp(1.15rem,2vw,1.55rem)] leading-[1.45] text-[#f3effc] text-shadow-[0_0.1rem_1.4rem_rgb(6_3_18/62%)]">
            The selected transcript excerpts, nearby context, and your question. You choose the AI
            connection.
          </dd>
        </div>
        <div class="flex translate-y-10 flex-col gap-[0.9rem] border border-white/14 bg-[linear-gradient(105deg,rgb(12_7_31/78%)_0%,rgb(20_12_48/57%)_62%,rgb(29_17_64/34%)_100%)] px-[clamp(1.25rem,2.4vw,2.25rem)] py-[clamp(1.5rem,2.8vw,2.35rem)] opacity-0 shadow-[0_1.6rem_4rem_-2.4rem_rgb(3_2_12/78%),inset_0_1px_rgb(255_255_255/5%)] blur-[14px] backdrop-blur-[18px] backdrop-saturate-[0.86] will-change-[opacity,filter,transform] max-[900px]:translate-y-0 max-[900px]:opacity-100 max-[900px]:blur-none max-[900px]:will-change-auto max-sm:gap-4 motion-reduce:translate-y-0 motion-reduce:opacity-100 motion-reduce:blur-none motion-reduce:will-change-auto" data-privacy-item>
          <dt class="font-mono text-[0.7rem] font-bold tracking-[0.08em] text-[#d7c9ff] uppercase">Never sent</dt>
          <dd class="max-w-[34rem] text-[clamp(1.15rem,2vw,1.55rem)] leading-[1.45] text-[#f3effc] text-shadow-[0_0.1rem_1.4rem_rgb(6_3_18/62%)]">Audio, video, frames, or unrelated files from your computer.</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  const privacy = document.querySelector<HTMLElement>("[data-privacy-parallax]");
  const privacyStage = privacy?.querySelector<HTMLElement>("[data-privacy-stage]");
  const privacyItems = Array.from(
    privacy?.querySelectorAll<HTMLElement>("[data-privacy-item]") ?? [],
  );
  const privacyMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let privacyFrame = 0;

  const updatePrivacyParallax = () => {
    privacyFrame = 0;
    if (!privacy || !privacyStage) return;

    if (privacyMotion.matches || window.innerWidth <= 900) {
      privacyItems.forEach((item) => {
        item.style.removeProperty("opacity");
        item.style.removeProperty("transform");
        item.style.removeProperty("filter");
      });
      return;
    }

    const rect = privacy.getBoundingClientRect();
    const distance = Math.max(1, privacy.offsetHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, -rect.top / distance));
    privacyStage.style.setProperty(
      "--privacy-image-y",
      `${(-progress * window.innerHeight * 0.7).toFixed(1)}px`,
    );

    const revealStarts = [0.2, 0.45, 0.7];
    privacyItems.forEach((item, index) => {
      const reveal = Math.min(1, Math.max(0, (progress - revealStarts[index]) / 0.11));
      item.style.opacity = reveal.toFixed(3);
      item.style.transform = `translate3d(0, ${((1 - reveal) * 2.5).toFixed(2)}rem, 0)`;
      item.style.filter = `blur(${((1 - reveal) * 14).toFixed(1)}px)`;
    });
  };

  const requestPrivacyParallax = () => {
    if (privacyFrame) return;
    privacyFrame = requestAnimationFrame(updatePrivacyParallax);
  };

  updatePrivacyParallax();
  window.addEventListener("scroll", requestPrivacyParallax, { passive: true });
  window.addEventListener("lenis-scroll", requestPrivacyParallax);
  window.addEventListener("resize", requestPrivacyParallax, { passive: true });
  privacyMotion.addEventListener("change", requestPrivacyParallax);
</script>
