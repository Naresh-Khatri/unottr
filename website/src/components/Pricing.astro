---
import { ArrowRightIcon, CheckIcon } from "@phosphor-icons/react";
import { formatPrice, product } from "../data/product";

const price = formatPrice(product.price, product.currency);
const checkoutReady = Boolean(product.checkoutUrl);

const included = [
  "Local transcription and speaker labels",
  "Search across every meeting",
  "Timestamped playback and evidence-backed answers",
  "Connections for local models, installed agents, and hosted APIs",
  "Linux x64 and Apple Silicon downloads",
  `All updates in the unottr ${product.licenseVersion} release line`,
];
---

<main id="main-content" class="relative z-10 overflow-hidden bg-[#f4f0ff] text-ink">
  <section class="relative isolate overflow-hidden bg-[#5146c2] pt-40 pb-[clamp(8rem,16vw,14rem)] text-white" aria-labelledby="pricing-title">
    <img
      src="/images/hero-concepts/dream-cloud-peak.png"
      alt=""
      width="1672"
      height="941"
      class="pointer-events-none absolute inset-0 -z-3 h-full w-full scale-105 object-cover object-[center_44%] opacity-85"
      aria-hidden="true"
    />
    <div class="pointer-events-none absolute inset-0 -z-2 bg-[linear-gradient(180deg,rgb(41_28_118/50%),rgb(35_21_94/72%)),radial-gradient(circle_at_67%_42%,transparent_0%,rgb(26_15_72/32%)_72%)]" aria-hidden="true"></div>
    <div class="mx-auto grid w-[min(100%-2rem,87.5rem)] grid-cols-[0.9fr_1.1fr] items-end gap-[clamp(3rem,9vw,10rem)] max-[900px]:grid-cols-1">
      <div class="translate-y-8 opacity-0 transition-[opacity,transform] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:translate-y-0 motion-reduce:opacity-100 motion-reduce:transition-none" data-reveal>
        <p class="inline-flex items-center gap-[0.65rem] font-mono text-[0.69rem] font-bold tracking-[0.1em] text-white/76 uppercase before:h-px before:w-[1.6rem] before:bg-current before:content-['']">Pricing</p>
        <h1 id="pricing-title" class="mt-7 max-w-[9ch] text-[clamp(4rem,8.4vw,8.8rem)] leading-[0.86] font-[540] tracking-[-0.08em] text-balance">Keep the record. Skip the subscription.</h1>
      </div>
      <p class="max-w-[34rem] pb-2 text-[clamp(1rem,1.5vw,1.2rem)] leading-[1.7] text-white/78">
        unottr runs on your computer, so its price does not grow with your meeting count. Buy the current major version once and use it for as long as you want.
      </p>
    </div>
  </section>

  <section id="license" class="relative mx-auto -mt-[clamp(4rem,8vw,7rem)] w-[min(100%-2rem,74rem)] pb-[clamp(8rem,14vw,13rem)]">
    <article class="grid overflow-hidden rounded-[1.8rem] border border-[rgb(61_40_113/15%)] bg-[#fffaff] shadow-[0_3.5rem_8rem_-5rem_rgb(38_20_82/50%)] md:grid-cols-[0.78fr_1.22fr]">
      <div class="flex flex-col justify-between bg-[#241746] px-[clamp(1.6rem,4vw,3.5rem)] py-[clamp(2.2rem,5vw,4.5rem)] text-white">
        <div>
          <p class="font-mono text-[0.66rem] font-bold tracking-[0.1em] text-[#cdbdff] uppercase">Personal license · unottr {product.licenseVersion}</p>
          <div class="mt-10 flex items-end gap-3">
            <span class="text-[clamp(4.8rem,9vw,8rem)] leading-[0.72] font-[560] tracking-[-0.085em] tabular-nums">{price}</span>
            <span class="pb-1.5 text-[0.82rem] text-white/58">USD</span>
          </div>
          <p class="mt-7 max-w-[24rem] text-[1rem] leading-7 text-white/72">One payment. No recurring license fee and no charge per recording.</p>
        </div>

        <div id="purchase" class="mt-12">
          {checkoutReady ? (
            <a href={product.checkoutUrl} class="group inline-flex min-h-13 w-full items-center justify-between rounded-full bg-white px-5 text-[0.92rem] font-[680] text-[#31245f] transition duration-200 hover:-translate-y-px hover:bg-[#f8e9ff] active:translate-y-0">
              Buy unottr
              <ArrowRightIcon size={18} weight="bold" className="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
            </a>
          ) : (
            <span class="inline-flex min-h-13 w-full cursor-not-allowed items-center justify-center rounded-full border border-white/14 bg-white/8 px-5 text-[0.88rem] font-[650] text-white/62" aria-disabled="true">
              Checkout opening soon
            </span>
          )}
          <p class="mt-3 text-center text-[0.7rem] leading-5 text-white/46">Third-party AI usage, if you choose it, is billed by that provider.</p>
        </div>
      </div>

      <div class="px-[clamp(1.6rem,5vw,4.8rem)] py-[clamp(2.3rem,5vw,4.7rem)]">
        <p class="font-mono text-[0.67rem] font-bold tracking-[0.1em] text-[#6848c7] uppercase">Included with your license</p>
        <ul class="mt-8 border-t border-rule">
          {included.map((item) => (
            <li class="grid grid-cols-[1.5rem_1fr] gap-3 border-b border-rule py-4 text-[0.94rem] leading-6 text-[#4f4264]">
              <CheckIcon size={17} weight="bold" className="mt-1 text-[#6848c7]" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-7 text-[0.78rem] leading-6 text-[#746985]">
          The license is for one person and covers personal and commercial work. Major upgrades after {product.licenseVersion} may be sold separately.
        </p>
      </div>
    </article>
  </section>

  <section class="border-t border-rule bg-[#eee8ff] py-[clamp(7rem,12vw,11rem)]" aria-labelledby="pricing-questions">
    <div class="mx-auto grid w-[min(100%-2rem,74rem)] grid-cols-[0.7fr_1.3fr] gap-[clamp(3rem,10vw,10rem)] max-[800px]:grid-cols-1">
      <div>
        <p class="font-mono text-[0.68rem] font-bold tracking-[0.1em] text-[#6848c7] uppercase">Before you buy</p>
        <h2 id="pricing-questions" class="mt-6 text-[clamp(2.8rem,5vw,5.3rem)] leading-[0.93] font-[540] tracking-[-0.065em]">The useful details.</h2>
      </div>
      <dl class="border-t border-[rgb(61_40_113/18%)]">
        <div class="grid grid-cols-[0.8fr_1.2fr] gap-8 border-b border-[rgb(61_40_113/18%)] py-7 max-sm:grid-cols-1 max-sm:gap-3">
          <dt class="font-[620] text-[#35264f]">Is AI included?</dt>
          <dd class="leading-7 text-[#675a7a]">The app includes AI connections, not model usage. Local model servers can run without a provider fee. Hosted services bill against your own account.</dd>
        </div>
        <div class="grid grid-cols-[0.8fr_1.2fr] gap-8 border-b border-[rgb(61_40_113/18%)] py-7 max-sm:grid-cols-1 max-sm:gap-3">
          <dt class="font-[620] text-[#35264f]">Does unottr upload my meetings?</dt>
          <dd class="leading-7 text-[#675a7a]">No. Transcription, speaker labels, search, and storage stay on your computer. AI sends selected transcript context only when you ask a question through a hosted connection.</dd>
        </div>
        <div class="grid grid-cols-[0.8fr_1.2fr] gap-8 border-b border-[rgb(61_40_113/18%)] py-7 max-sm:grid-cols-1 max-sm:gap-3">
          <dt class="font-[620] text-[#35264f]">Which computers are supported?</dt>
          <dd class="leading-7 text-[#675a7a]">The current release supports Linux on x64 hardware and macOS 15 or later on Apple Silicon.</dd>
        </div>
        <div class="grid grid-cols-[0.8fr_1.2fr] gap-8 border-b border-[rgb(61_40_113/18%)] py-7 max-sm:grid-cols-1 max-sm:gap-3">
          <dt class="font-[620] text-[#35264f]">What happens when version 2 ships?</dt>
          <dd class="leading-7 text-[#675a7a]">Your {product.licenseVersion} copy keeps working. You can choose whether a future paid major upgrade is worth it.</dd>
        </div>
      </dl>
    </div>
  </section>
</main>
